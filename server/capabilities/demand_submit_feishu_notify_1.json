{
  "id": "demand_submit_feishu_notify_1",
  "pluginKey": "@official-plugins/send-feishu-message",
  "pluginVersion": "1.0.29",
  "name": "新需求提交飞书通知",
  "description": "新需求提交后自动给需求管理员发送飞书卡片消息，包含需求摘要与AI合并建议，支持跳转至需求整合页",
  "icon": "",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "linkUrl": {
        "type": "string",
        "description": "底部跳转按钮的URL，点击进入应用需求整合页"
      },
      "receiverUserList": {
        "description": "接收人用户ID列表",
        "items": {
          "type": "string",
          "description": "用户ID"
        },
        "type": "array"
      },
      "title": {
        "description": "消息卡片标题",
        "type": "string"
      },
      "content": {
        "description": "markdown格式正文，包含新需求摘要与AI合并建议",
        "type": "string"
      }
    },
    "required": [
      "receiverUserList",
      "title",
      "content",
      "linkUrl"
    ]
  },
  "formValue": {
    "receiverUserList": "{{input.receiverUserList}}",
    "buttons": [
      {
        "text": "前往整合",
        "url": "{{input.linkUrl}}",
        "style": "primary"
      }
    ],
    "sender": "bot",
    "title": {
      "color": "blue",
      "title": "{{input.title}}"
    },
    "content": "{{input.content}}"
  },
